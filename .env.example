# Application
APP_NAME="CixioHub API"
DEBUG=False

# Database (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://cixiohub:cixiohub@localhost:5432/cixiohub

# Redis Cache & Sessions
REDIS_URL=redis://localhost:6379/0

# JWT Security (Must match hub_notify JWT_SECRET_KEY)
SECRET_KEY=dev_secret_key_for_cixiohub_backend_token_signing_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Microservice & Remote AI Client (hub_ai running on port 8003)
USE_REMOTE_AI=True
AI_SERVICE_URL=http://localhost:8003
AI_API_KEY=1234

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=qwen3-vl:2b
ENABLE_VISION_RAG=True
ENABLE_WEB_SEARCH=False
TAVILY_API_KEY=

# Qdrant Vector Storage
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=user_documents

# ChromaDB (Optional)
CHROMA_HOST=localhost
CHROMA_PORT=8002

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:8001/api/v1/notify/send

# SMTP / Email (Mailpit / Maildev local server)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@hub.cixio.dev

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# File Upload Limits
MAX_UPLOAD_SIZE_MB=50

# Test User Credentials
TEST_EMAIL=test@tkmce.ac.in
TEST_PASSWORD=Test@123
TEST_NAME="Test User"
TEST_PHONE=9876543210

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
